SECRET_KEY=replace-with-a-session-secret
SOMEE_SQLSERVER_CONNECTION_STRING=
# Key from https://tavily.com — the app loads this file on startup.
MCP_TAVILY_API_KEY=
MCP_TAVILY_COMMAND=.venv\Scripts\python.exe tavily_mcp_server.py
# JSON {"address":"you@gmail.com","app_password":"..."} or a path to that JSON file.
MCP_GMAIL_CREDENTIALS=
MCP_GMAIL_COMMAND=.venv\Scripts\python.exe gmail_mcp_server.py
VECTOR_STORE_PATH=instance/chroma
# Local model used only to phrase the agent rationale. The decision stays in the rules.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
